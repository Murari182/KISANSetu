# Kisan Setu - Digital Agriculture Platform
# Production Frontend Environment Configuration

# Google Gemini API Key (Server-side only - NEVER expose via NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key

# Backend API URL (FastAPI / Node.js backend integration point)
NEXT_PUBLIC_API_URL=https://api.kisansetu.in/v1

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional Feature Flags
NEXT_PUBLIC_ENABLE_ML_DISEASE_DIAGNOSTICS=true
NEXT_PUBLIC_ENABLE_VOICE_ASSISTANT=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_MANDI_REFRESH_INTERVAL_SEC=300
